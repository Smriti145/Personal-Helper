{
  "name": "personal-helper-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start-metro.cjs",
    "android": "react-native run-android --port 8082",
    "ios": "react-native run-ios --port 8082",
    "typecheck": "tsc --noEmit",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/android/index.android.bundle --assets-dest build/android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/ios/main.jsbundle --assets-dest build/ios",
    "bundle": "npm run bundle:android && npm run bundle:ios"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "@notifee/react-native": "9.1.8",
    "react-native-keychain": "10.0.0",
    "react-native-get-random-values": "2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/react": "^19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
